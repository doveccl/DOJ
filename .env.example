DATABASE=postgres://postgres@localhost:5432/postgres
REDIS=redis://localhost:6379

PORT=7974
WEB_PORT=28080
# AI coaching is configured at runtime in Admin > Settings > AI
# (provider / API key / base URL / model), not via environment variables.

# DOCKER_HOST=unix:///var/run/docker.sock
SECRET=local-dev-secret-change-me
SERVER=http://127.0.0.1:7974
AGENT_NAME=Local Agent
AGENT_CONCURRENCY=2
AGENT_CACHE_GB=4
# Remote judge hosts run apps/agent only. Keep Docker local on that host and point
# the agent at the central worker, for example:
# SERVER=https://judge.example.com

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=doj

ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=admin12345
