DATABASE_URL=postgres://postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

DOJ_API_PORT=7974
DOJ_WEB_PORT=28080
AI_PROVIDER=local-rules
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# DOCKER_HOST=unix:///var/run/docker.sock
DOJ_WORKER_AGENT_PORT=7975
DOJ_WORKER_WS_URL=ws://localhost:7975/agents/connect
DOJ_AGENT_KEY=local-agent
DOJ_AGENT_TOKEN=local-agent-token
DOJ_AGENT_NAME=Local Agent
DOJ_AGENT_CONCURRENCY=2
DOJ_AGENT_LABELS=local
# Remote judge hosts run apps/agent only. Keep Docker local on that host and point
# the agent at the central worker, for example:
# DOJ_WORKER_WS_URL=wss://local-agent:local-agent-token@judge.example.com/agents/connect

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=doj

DOJ_ADMIN_NAME=admin
DOJ_ADMIN_EMAIL=admin@example.test
DOJ_ADMIN_PASSWORD=admin12345
