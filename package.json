{
  "name": "doj",
  "version": "5.0.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel 'dev:*'",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "check": "bun run scripts/check.ts",
    "lint": "eslint .",
    "smoke": "bun run scripts/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run packages/db/src/seed.ts",
    "migrate:v3-json": "bun run scripts/migrate-v3-json.ts",
    "s3:ensure-bucket": "bun run scripts/ensure-bucket.ts",
    "db:reset": "docker compose -f compose.dev.yml down -v && docker compose -f compose.dev.yml up -d --wait && bun run db:migrate && bun run s3:ensure-bucket && bun run db:seed",
    "format": "prettier --write . --ignore-unknown"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@mdit/plugin-tasklist": "^0.23.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dockerode": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "tar-stream": "^3.2.0",
    "vue": "^3.5.35",
    "vue-codemirror6": "^1.5.2",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/dockerode": "^4.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  }
}
