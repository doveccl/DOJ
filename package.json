{
  "name": "doj",
  "version": "5.0.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run dev:api, dev:worker, and dev:web in separate terminals.\"",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "check": "bun run --cwd packages/shared check && bun run --cwd packages/db check && bun run --cwd packages/runner check && bun run --cwd apps/api check && bun run --cwd apps/worker check && bun run --cwd apps/web check",
    "runner:smoke": "bun run packages/runner/src/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run packages/db/src/seed.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@hono/node-server": "^1.13.0",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "naive-ui": "^2.40.0",
    "nanoid": "^5.0.0",
    "pinia": "^2.3.0",
    "postgres": "^3.4.5",
    "tar-stream": "^3.2.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/dockerode": "^3.3.0",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-vue": "^5.2.0",
    "drizzle-kit": "^0.30.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
