{
  "name": "doj",
  "version": "5.0.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run dev:api, dev:worker, and dev:web in separate terminals.\"",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "check": "bun run --cwd packages/shared check && bun run --cwd packages/db check && bun run --cwd packages/storage check && bun run --cwd packages/runner check && bun run --cwd apps/api check && bun run --cwd apps/worker check && bun run --cwd apps/web check",
    "smoke": "bun run auth:smoke && bun run admin:smoke && bun run languages:smoke && bun run runners:smoke && bun run group-membership:smoke && bun run assignment:smoke && bun run my-assignments:smoke && bun run contest:smoke && bun run bbs:smoke && bun run rank:smoke && bun run runner:smoke && bun run e2e:smoke && bun run testcases:smoke && bun run ai:smoke",
    "runner:smoke": "bun run packages/runner/src/smoke.ts",
    "e2e:smoke": "bun run scripts/e2e-smoke.ts",
    "testcases:smoke": "bun run scripts/testcases-smoke.ts",
    "ai:smoke": "bun run scripts/ai-coach-smoke.ts",
    "auth:smoke": "bun run scripts/auth-smoke.ts",
    "admin:smoke": "bun run scripts/admin-smoke.ts",
    "languages:smoke": "bun run scripts/languages-smoke.ts",
    "runners:smoke": "bun run scripts/runners-smoke.ts",
    "assignment:smoke": "bun run scripts/assignment-smoke.ts",
    "my-assignments:smoke": "bun run scripts/my-assignments-smoke.ts",
    "contest:smoke": "bun run scripts/contest-smoke.ts",
    "bbs:smoke": "bun run scripts/bbs-smoke.ts",
    "rank:smoke": "bun run scripts/rank-smoke.ts",
    "group-membership:smoke": "bun run scripts/group-membership-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run packages/db/src/seed.ts",
    "migrate:v3-json": "bun run scripts/migrate-v3-json.ts",
    "s3:ensure-bucket": "bun run scripts/ensure-bucket.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "dockerode": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "tar-stream": "^3.2.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/dockerode": "^4.0.1",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
  }
}
